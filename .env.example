# Leader_Lab local environment example
# Copy to .env on the local runner PC and fill real values.
# Do not commit .env.

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DB_STOCK_INFO=stock_info
MYSQL_DB_STOCK_INFORMATION=stock_information

# Local source data
SQLITE_1516_DB=E:\2026\kiwoom1516\kiwoom_1516.sqlite3
RAW_1516_DIR=E:\2026\kiwoom1516\raw_1516

# server32 minute candle API
SERVER32_BASE_URL=http://localhost:8081
SERVER32_MINUTE_ENDPOINT=/api/market/candles/minute

# Runtime folders
DATA_ROOT=E:\leader_lab_data
CACHE_ROOT=E:\leader_lab_data\cache
REPORT_ROOT=E:\leader_lab_data\reports
LOG_ROOT=E:\leader_lab_data\logs

# Experiment defaults
DEFAULT_SEARCH_TIME=09:05:00
DEFAULT_CONDITION_NAME=1516
DEFAULT_HOLD_PERIOD=7시간
MINUTE5_PREFETCH_COUNT=200
